{
  "$comment": "Single source for UI design tokens (10-ui.md 2.7). packages/ui/scripts/build-tokens.ts emits tokens.css; vite.config.ts reads manifest colors from here.",
  "manifest": {
    "themeColor": "#0b1426",
    "backgroundColor": "#0b1426"
  },
  "root": {
    "color-bg": "#0b1426",
    "color-surface": "#142040",
    "color-surface-raised": "#1b2b54",
    "color-text": "#f2f5fb",
    "color-text-muted": "#aab4cc",
    "color-accent": "#ff7a3d",
    "color-accent-contrast": "#1a0c04",
    "color-danger": "#ff6b6b",
    "color-focus": "#7cc4ff",
    "font-display": "ui-rounded, 'SF Pro Rounded', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "font-text": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "font-mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "text-xs": "0.75rem",
    "text-sm": "0.875rem",
    "text-md": "1rem",
    "text-lg": "1.25rem",
    "text-xl": "1.75rem",
    "text-2xl": "2.5rem",
    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "0.75rem",
    "space-4": "1rem",
    "space-6": "1.5rem",
    "space-8": "2rem",
    "radius-sm": "0.375rem",
    "radius-md": "0.75rem",
    "radius-lg": "1.25rem",
    "motion-fast": "120ms",
    "motion-base": "220ms",
    "motion-slow": "420ms",
    "z-base": "0",
    "z-hud": "10",
    "z-menu": "20",
    "z-toast": "30",
    "z-overlay": "40"
  },
  "themes": {
    "light": {
      "color-bg": "#f4f6fb",
      "color-surface": "#ffffff",
      "color-surface-raised": "#e8ecf6",
      "color-text": "#0b1426",
      "color-text-muted": "#4a5673",
      "color-accent": "#c4470e",
      "color-accent-contrast": "#ffffff",
      "color-danger": "#b3261e",
      "color-focus": "#0b63c4"
    }
  },
  "contrast": {
    "high": {
      "color-bg": "#000000",
      "color-surface": "#000000",
      "color-surface-raised": "#101010",
      "color-text": "#ffffff",
      "color-text-muted": "#e0e0e0",
      "color-accent": "#ffd23f",
      "color-accent-contrast": "#000000",
      "color-focus": "#ffffff"
    }
  },
  "reducedMotion": {
    "motion-fast": "0ms",
    "motion-base": "0ms",
    "motion-slow": "0ms"
  }
}
