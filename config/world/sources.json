{
  "schema": "world-sources/1",
  "note": "Open data only (R-IP-01). Google Photorealistic 3D Tiles and Mapbox are never sources (F-055, F-056); sources.schema.json and S0 both refuse their hosts (DL-676). Licence and attribution text per source feed config/attribution.world.json.",
  "sources": [
    {
      "id": "datasf-footprints",
      "kind": "socrata",
      "dataset": "ynuv-fyni",
      "url": "https://data.sf.gov/resource/ynuv-fyni.json",
      "select": "sf16_bldgid,shape,hgt_mediancm,hgt_maxcm,gnd_mediancm,p2010_zmaxn88ft",
      "geometryColumn": "shape",
      "file": "ynuv-fyni.jsonl",
      "licence": "PDDL-1.0",
