      "file": "ramy-di5m.jsonl",
      "licence": "PDDL-1.0",
      "licenceUrl": "https://opendatacommons.org/licenses/pddl/1-0/",
      "attribution": "City and County of San Francisco",
      "source": "DataSF Addresses with Units, EAS (ramy-di5m); used from M02a2",
      "surfaces": ["boot-splash", "full-map", "pause-credits", "docs-legal"]
    },
    {
      "id": "datasf-parks",
      "kind": "socrata",
      "dataset": "gtr9-ntp6",
      "url": "https://data.sf.gov/resource/gtr9-ntp6.json",
      "select": "property_id,property_name,propertytype,acres,shape",
      "geometryColumn": "shape",
      "file": "gtr9-ntp6.jsonl",
