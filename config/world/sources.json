      "kind": "socrata",
      "dataset": "tkzw-k3nq",
      "url": "https://data.sf.gov/resource/tkzw-k3nq.json",
      "select": "treeid,species,latitude,longitude",
      "geometryColumn": null,
      "file": "tkzw-k3nq.jsonl",
