    },
    {
      "id": "osm",
      "kind": "osm",
      "url": "https://download.geofabrik.de/north-america/us/california/norcal-latest.osm.pbf",
      "file": "osm.geojsonl",
      "licence": "ODbL-1.0",
      "licenceUrl": "https://opendatacommons.org/licenses/odbl/1-0/",
      "attribution": "© OpenStreetMap contributors",
      "source": "OpenStreetMap via Geofabrik NorCal extract and osmium",
      "surfaces": ["boot-splash", "full-map", "pause-credits", "docs-legal"]
    }
  ],
  "terrarium": {
    "core": { "z": 15, "boxes": ["stream", "play"] },
    "far": { "z": 12, "boxes": ["far"] }
  },
  "osm": {
    "note": "U-W1 and U-W2: the Geofabrik URL and the osmium flags below are UNVERIFIED until the operator first runs them (AC-9); record what worked here. The OSM reader accepts GeoJSON lines from any route: a hand-supplied .cache/map/raw/sf/osm.geojsonl is used as is.",
    "bboxes": {
      "sf": { "minLat": 37.68, "minLng": -122.55, "maxLat": 37.89, "maxLng": -122.3 },
      "backdrop": { "minLat": 37.3, "minLng": -122.6, "maxLat": 38.0, "maxLng": -121.8 }
    },
    "tagFilter": "nwr/highway nwr/railway nwr/route=ferry nwr/natural=coastline,water,tree nwr/leisure nwr/landuse nwr/man_made=pier nwr/building nwr/bridge nwr/tunnel n/highway=traffic_signals,stop r/type=restriction",
    "commands": [
      "osmium extract --bbox={sf.minLng},{sf.minLat},{sf.maxLng},{sf.maxLat} --strategy=complete_ways --overwrite -o {dir}/osm-sf.osm.pbf {pbf}",
      "osmium tags-filter --overwrite -o {dir}/osm-sf-tags.osm.pbf {dir}/osm-sf.osm.pbf {tagFilter}",
      "osmium export --overwrite --add-unique-id=type_id -f geojsonseq -x print_record_separator=false -o {dir}/osm.geojsonl {dir}/osm-sf-tags.osm.pbf"
    ],
    "backdropCommands": [
      "osmium extract --bbox={backdrop.minLng},{backdrop.minLat},{backdrop.maxLng},{backdrop.maxLat} --strategy=simple --overwrite -o {dir}/osm-backdrop.osm.pbf {pbf}"
    ]
  },
  "areas": {
    "sf": {
      "label": "San Francisco, the real city: network, osmium, baked and published by the operator",
      "network": true,
      "box": "play",
      "sources": ["datasf-footprints", "datasf-streets", "datasf-neighborhoods", "datasf-addresses", "datasf-parks", "datasf-muni-stops", "datasf-muni-routes", "datasf-trees", "terrarium", "osm"],
      "gates": {
        "s0": { "minRows": { "datasf-footprints": 150000, "datasf-streets": 16000 }, "exactRows": { "datasf-neighborhoods": 41 } },
        "s2": { "cityHallM": [10, 25], "minM": -130 },
        "s3": { "landRatioTolerance": 0.03, "minRingKm2": 0.05 },
        "s4": { "minBakedFraction": 0.98, "maxOsmFraction": 0.05 },
        "s13": { "packMaxBytes": 4194304, "packWarnBytes": 2621440 }
      }
    },
    "civic-excerpt": {
      "label": "Committed 1 km2 source excerpt around City Hall (chunks 9/254..257 on both axes): byte-reproducible bakes in CI",
      "network": false,
      "box": { "minX": -640, "minZ": -640, "maxX": 384, "maxZ": 384 },
      "sources": ["datasf-footprints", "datasf-neighborhoods", "datasf-parks", "datasf-trees", "terrarium", "osm"],
      "gates": {
        "s0": { "minRows": { "datasf-footprints": 500 }, "exactRows": {} },
        "s2": { "cityHallM": [10, 25], "minM": -130 },
        "s3": { "landRatioTolerance": 0.03, "minRingKm2": 0.25 },
        "s4": { "minBakedFraction": 0.98, "maxOsmFraction": 0.05 },
        "s13": { "packMaxBytes": 4194304, "packWarnBytes": 2621440 }
      }
    },
    "synth": {
      "label": "Offline seeded sources in the raw formats over the whole play box: the full-size CI world for M02b1-M02d2. Stamps are authored; QA only, never in assets.lock.json",
      "network": false,
      "box": "play",
      "sources": ["datasf-footprints", "datasf-neighborhoods", "datasf-parks", "datasf-trees", "terrarium", "osm"],
      "gates": {
        "s0": { "minRows": { "datasf-footprints": 50000 }, "exactRows": { "datasf-neighborhoods": 41 } },
        "s2": { "cityHallM": [10, 25], "minM": -130 },
        "s3": { "landRatioTolerance": 0.03, "minRingKm2": 0.01 },
        "s4": { "minBakedFraction": 0.98, "maxOsmFraction": 0.05 },
        "s13": { "packMaxBytes": 4194304, "packWarnBytes": 2621440 }
      }
    }
  }
}
