    },
    {
      "id": "datasf-muni-stops",
      "kind": "socrata",
      "dataset": "i28k-bkz6",
      "url": "https://data.sf.gov/resource/i28k-bkz6.json",
      "select": "stopname,stopid,latitude,longitude,shelter",
      "geometryColumn": null,
      "file": "i28k-bkz6.jsonl",
      "licence": "PDDL-1.0",
      "licenceUrl": "https://opendatacommons.org/licenses/pddl/1-0/",
      "attribution": "City and County of San Francisco, SFMTA",
      "source": "DataSF Muni Stops (i28k-bkz6); used from M02a2",
