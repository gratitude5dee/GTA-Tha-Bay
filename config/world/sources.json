      "url": "https://data.sf.gov/resource/j2bu-swwd.json",
      "select": "nhood,the_geom",
      "geometryColumn": "the_geom",
      "file": "j2bu-swwd.jsonl",
      "licence": "PDDL-1.0",
      "licenceUrl": "https://opendatacommons.org/licenses/pddl/1-0/",
      "attribution": "City and County of San Francisco",
      "source": "DataSF Analysis Neighborhoods (j2bu-swwd)",
      "surfaces": ["boot-splash", "full-map", "pause-credits", "docs-legal"]
