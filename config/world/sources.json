      "attribution": "City and County of San Francisco",
      "source": "DataSF Building Footprints (ynuv-fyni)",
      "surfaces": ["boot-splash", "full-map", "pause-credits", "docs-legal"]
    },
    {
      "id": "datasf-streets",
      "kind": "socrata",
      "dataset": "3psu-pn9h",
      "url": "https://data.sf.gov/resource/3psu-pn9h.json",
      "select": "cnn,streetname,st_type,classcode,oneway,layer,f_node_cnn,t_node_cnn,nhood,analysis_neighborhood,active,line",
      "geometryColumn": "line",
      "file": "3psu-pn9h.jsonl",
      "licence": "PDDL-1.0",
      "licenceUrl": "https://opendatacommons.org/licenses/pddl/1-0/",
      "attribution": "City and County of San Francisco",
      "source": "DataSF Streets (3psu-pn9h); used from M02a2",
      "surfaces": ["boot-splash", "full-map", "pause-credits", "docs-legal"]
    },
    {
