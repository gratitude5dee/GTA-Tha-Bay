    {
      "id": "terrarium",
      "kind": "terrarium",
      "url": "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png",
      "file": "terrarium",
      "licence": "LicenseRef-PublicDomain-USGov",
      "licenceUrl": "https://registry.opendata.aws/terrain-tiles",
      "attribution": "3DEP data courtesy of the U.S. Geological Survey",
      "source": "AWS Terrain Tiles, Terrarium PNG (3DEP and SRTM, Mapzen); there is no licence URL, the registry page is the citation",
