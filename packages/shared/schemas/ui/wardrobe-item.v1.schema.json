{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wardrobe-item.v1",
  "title": "Creator catalog part with its slot (CreatorPart, 10-ui-pages.md section 4.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "id", "index", "titleKey", "tags"],
  "properties": {
    "slot": { "enum": ["body", "face", "hair", "top", "bottom", "shoes", "accessory", "voice", "fightStyle"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,62}$" },
    "index": { "type": "integer", "minimum": 1, "maximum": 255 },
    "titleKey": { "type": "string", "pattern": "^[a-z][\\w-]*(\\.[\\w-]+)+$" },
    "model": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z0-9][a-z0-9._-]*$" },
    "portrait": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z0-9][a-z0-9._-]*$" },
    "fallbackPart": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,62}$", "description": "a Coast row without a model draws this same-slot realistic row, tinted with its own color (M10d4)" },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]*$" }, "uniqueItems": true },
    "unlock": { "type": "string" },
    "retired": { "type": "boolean" },
    "tint": { "type": "number", "minimum": 0, "maximum": 1, "description": "mannequin variant hue for parts without a model" },
    "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$", "description": "mannequin colour for parts without a model; overrides tint (DL-737)" },
    "icon": { "type": "string", "description": "symbol id in assets/creator-kit/icons.svg" }
  }
}
