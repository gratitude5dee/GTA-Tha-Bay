{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soul-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "soulVersion",
    "status",
    "origin",
    "ownerProfileId",
    "name",
    "shortBio",
    "archetype",
    "tags",
    "tier",
    "minor",
    "likeness",
    "visual_brief",
    "standIn",
    "heightM",
    "moves",
    "roles",
    "speech",
    "voice",
    "personality",
    "knowledge",
    "relations",
    "locations",
    "schedule",
    "goals",
    "stats",
    "rails",
    "dialogue",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "soul/1.0"
    },
    "id": {
      "$ref": "#/$defs/npcId"
    },
    "soulVersion": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "origin": {
      "enum": [
        "first_party",
        "user"
      ]
    },
    "ownerProfileId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "shortBio": {
      "type": "string",
      "maxLength": 280
    },
    "archetype": {
      "enum": [
        "rapper",
        "founder",
        "vc",
        "influencer",
        "athlete",
        "civilian",
        "police",
        "vendor",
        "official",
        "other"
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{2,32}$"
      }
    },
    "tier": {
      "enum": [
        "consented",
        "parody",
        "fictionalized"
      ]
    },
    "minor": {
      "const": false
    },
    "likeness": {
      "$ref": "#/$defs/likeness"
    },
    "visual_brief": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    },
    "standIn": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^character/[a-z][a-z0-9_-]{2,47}$"
    },
    "heightM": {
      "type": "number",
      "minimum": 1.4,
      "maximum": 2.2
    },
    "moves": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hero",
        "questGiver",
        "vendor",
        "fighter",
        "tycoonActor",
        "racer"
      ],
      "properties": {
        "hero": {
          "type": "boolean"
        },
        "questGiver": {
          "type": "boolean"
        },
        "vendor": {
          "type": "boolean"
        },
        "fighter": {
          "type": "boolean"
        },
        "tycoonActor": {
          "type": "boolean"
        },
        "racer": {
          "type": "boolean"
        }
      }
    },
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "register",
        "lexicon",
        "catchphrases",
        "avoid",
        "verbosity",
        "maxWordsPerLine",
        "profanity",
        "languages"
      ],
      "properties": {
        "register": {
          "$ref": "#/$defs/s40x6"
        },
        "dialectNotes": {
          "type": "string",
          "maxLength": 400
        },
        "lexicon": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term",
              "gloss",
              "freq"
            ],
            "properties": {
              "term": {
                "type": "string",
                "maxLength": 40
              },
              "gloss": {
                "type": "string",
                "maxLength": 120
              },
              "freq": {
                "enum": [
                  "rare",
                  "sometimes",
                  "often"
                ]
              }
            }
          }
        },
        "catchphrases": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "avoid": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "verbosity": {
          "enum": [
            "terse",
            "normal",
            "chatty"
          ]
        },
        "maxWordsPerLine": {
          "type": "integer",
          "minimum": 8,
          "maximum": 60
        },
        "profanity": {
          "enum": [
            "none",
            "mild",
            "strong"
          ]
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "design_prompt",
        "voiceRef",
        "speed"
      ],
      "properties": {
        "tier": {
          "enum": [
            "text",
            "t1",
            "t2",
            "t3"
          ]
        },
        "design_prompt": {
          "type": "string",
          "maxLength": 300
        },
        "voiceRef": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^voice/[a-z0-9][a-z0-9._-]{1,62}$"
        },
        "speed": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2
        }
      }
    },
    "personality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traits",
        "values",
        "motivations",
        "fears",
        "humor",
        "temperament"
      ],
      "properties": {
        "traits": {
          "$ref": "#/$defs/s40x8"
        },
        "values": {
          "$ref": "#/$defs/s80x6"
        },
        "motivations": {
          "$ref": "#/$defs/s80x6"
        },
        "fears": {
          "$ref": "#/$defs/s80x6"
        },
        "humor": {
          "type": "string",
          "maxLength": 160
        },
        "temperament": {
          "enum": [
            "calm",
            "volatile",
            "warm",
            "cold"
          ]
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knows",
        "doesNotKnow",
        "era",
        "realWorldRefs"
      ],
      "properties": {
        "knows": {
          "$ref": "#/$defs/s80x24"
        },
        "doesNotKnow": {
          "$ref": "#/$defs/s80x24"
        },
        "era": {
          "type": "string",
          "maxLength": 40
        },
        "realWorldRefs": {
          "enum": [
            "none",
            "public_record",
            "free"
          ]
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "npc",
          "kind",
          "affinity",
          "note"
        ],
        "properties": {
          "npc": {
            "$ref": "#/$defs/npcId"
          },
          "kind": {
            "enum": [
              "ally",
              "rival",
              "mentor",
              "protege",
              "family",
              "business",
              "beef"
            ]
          },
          "affinity": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          },
          "note": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "locations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "districts",
        "home",
        "hangouts"
      ],
      "properties": {
        "districts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{2,32}$"
          }
        },
        "home": {
          "$ref": "#/$defs/poi"
        },
        "hangouts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/poi"
          }
        }
      }
    },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "goals": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]{3,32}$"
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fighter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "power",
            "speed",
            "defense",
            "reach",
            "meterGain"
          ],
          "properties": {
            "power": {
              "$ref": "#/$defs/r10"
            },
            "speed": {
              "$ref": "#/$defs/r10"
            },
            "defense": {
              "$ref": "#/$defs/r10"
            },
            "reach": {
              "$ref": "#/$defs/r10"
            },
            "meterGain": {
              "$ref": "#/$defs/r10"
            }
          }
        },
        "tycoon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "riskAppetite",
            "valuationBias",
            "checkUsd"
          ],
          "properties": {
            "riskAppetite": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "valuationBias": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "checkUsd": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 0
                },
                "max": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "fighter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "specials",
        "super",
        "finisher",
        "introQuote",
        "winQuotes",
        "taunts"
      ],
      "properties": {
        "style": {
          "enum": [
            "rushdown",
            "zoner",
            "grappler",
            "all_round",
            "trickster",
            "power"
          ]
        },
        "specials": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/move"
          }
        },
        "super": {
          "$ref": "#/$defs/move"
        },
        "finisher": {
          "$ref": "#/$defs/move"
        },
        "introQuote": {
          "type": "string",
          "maxLength": 120
        },
        "winQuotes": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "taunts": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "tycoon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "thesis",
        "negotiationStyle",
        "redFlags",
        "pitchHooks"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "founder",
              "vc",
              "angel",
              "exec",
              "regulator",
              "journalist"
            ]
          }
        },
        "thesis": {
          "$ref": "#/$defs/s80x8"
        },
        "negotiationStyle": {
          "enum": [
            "hardball",
            "founder_friendly",
            "herd",
            "contrarian"
          ]
        },
        "redFlags": {
          "$ref": "#/$defs/s80x8"
        },
        "pitchHooks": {
          "$ref": "#/$defs/s80x8"
        }
      }
    },
    "rails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "forbiddenTopics",
        "never",
        "deflectionStyle",
        "mayReferenceRealEvents"
      ],
      "properties": {
        "rating": {
          "enum": [
            "T",
            "M"
          ]
        },
        "forbiddenTopics": {
          "$ref": "#/$defs/s80x24"
        },
        "never": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "deflectionStyle": {
          "type": "string",
          "maxLength": 200
        },
        "mayReferenceRealEvents": {
          "type": "boolean"
        }
      }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelTier",
        "maxTurnsPerEncounter",
        "ink",
        "barkPool"
      ],
      "properties": {
        "modelTier": {
          "enum": [
            "haiku",
            "sonnet"
          ]
        },
        "maxTurnsPerEncounter": {
          "type": "integer",
          "minimum": 4,
          "maximum": 20
        },
        "ink": {
          "type": "string",
          "pattern": "^content(-private)?/npcs/[a-z0-9_/-]+\\.ink$"
        },
        "barkPool": {
          "type": "string",
          "pattern": "^content(-private)?/npcs/[a-z0-9_/.-]+\\.json$"
        }
      }
    },
    "assetsPending": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoredBy",
        "generatedBy",
        "reviewedBy",
        "reviewedAt",
        "contentSha256"
      ],
      "properties": {
        "authoredBy": {
          "type": "string",
          "maxLength": 80
        },
        "generatedBy": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "model",
            "date"
          ],
          "properties": {
            "model": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "origin"
        ],
        "properties": {
          "origin": {
            "const": "user"
          }
        }
      },
      "then": {
        "properties": {
          "ownerProfileId": {
            "type": "string"
          },
          "tier": {
            "const": "fictionalized"
          },
          "likeness": {
            "properties": {
              "basis": {
                "const": "original"
              }
            }
          },
          "roles": {
            "properties": {
              "hero": {
                "const": false
              }
            }
          },
          "dialogue": {
            "properties": {
              "modelTier": {
                "const": "haiku"
              }
            }
          },
          "voice": {
            "properties": {
              "tier": {
                "enum": [
                  "text",
                  "t1"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "reviewedBy": {
                "type": "string"
              },
              "reviewedAt": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "roles"
        ],
        "properties": {
          "roles": {
            "required": [
              "fighter"
            ],
            "properties": {
              "fighter": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "fighter"
        ],
        "properties": {
          "stats": {
            "required": [
              "fighter"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "roles"
        ],
        "properties": {
          "roles": {
            "required": [
              "tycoonActor"
            ],
            "properties": {
              "tycoonActor": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "tycoon"
        ],
        "properties": {
          "stats": {
            "required": [
              "tycoon"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "dialogue"
        ],
        "properties": {
          "dialogue": {
            "required": [
              "modelTier"
            ],
            "properties": {
              "modelTier": {
                "const": "sonnet"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "roles": {
            "properties": {
              "hero": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "const": "consented"
          }
        }
      },
      "then": {
        "properties": {
          "likeness": {
            "properties": {
              "basis": {
                "const": "real_person"
              },
              "consentRecordId": {
                "type": "string"
              },
              "consentScopes": {
                "minItems": 1
              },
              "disclaimer": {
                "const": "courtesy"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "enum": [
              "parody",
              "fictionalized"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "likeness": {
            "properties": {
              "faceReferenceAllowed": {
                "const": false
              }
            }
          },
          "voice": {
            "properties": {
              "tier": {
                "enum": [
                  "text",
                  "t1",
                  "t2"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "const": "parody"
          }
        }
      },
      "then": {
        "properties": {
          "knowledge": {
            "properties": {
              "realWorldRefs": {
                "enum": [
                  "none",
                  "public_record"
                ]
              }
            }
          },
          "likeness": {
            "properties": {
              "basis": {
                "const": "real_person"
              },
              "nameDistanceOk": {
                "const": true
              },
              "disclaimer": {
                "const": "parody"
              },
              "deceased": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "const": "fictionalized"
          }
        }
      },
      "then": {
        "properties": {
          "knowledge": {
            "properties": {
              "realWorldRefs": {
                "const": "none"
              }
            }
          },
          "likeness": {
            "properties": {
              "disclaimer": {
                "enum": [
                  "fictional",
                  "none"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "likeness"
        ],
        "properties": {
          "likeness": {
            "required": [
              "basis"
            ],
            "properties": {
              "basis": {
                "const": "real_person"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "standIn": {
            "type": "string"
          },
          "likeness": {
            "properties": {
              "subjectId": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "likeness"
        ],
        "properties": {
          "likeness": {
            "required": [
              "basis"
            ],
            "properties": {
              "basis": {
                "const": "original"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tier": {
            "const": "fictionalized"
          },
          "likeness": {
            "properties": {
              "subjectId": {
                "const": null
              },
              "consentRecordId": {
                "const": null
              },
              "consentScopes": {
                "maxItems": 0
              },
              "fameDomain": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "voice"
        ],
        "properties": {
          "voice": {
            "required": [
              "tier"
            ],
            "properties": {
              "tier": {
                "const": "t3"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tier": {
            "const": "consented"
          },
          "likeness": {
            "properties": {
              "consentScopes": {
                "contains": {
                  "const": "voice_clone"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "npcId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,47}$"
    },
    "poi": {
      "type": "string",
      "pattern": "^poi\\.[a-z0-9.-]{3,64}$"
    },
    "r10": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "s40x6": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "s40x8": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "s80x6": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "s80x8": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "s80x24": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{3,32}$"
        },
        "name": {
          "type": "string",
          "maxLength": 40
        },
        "input": {
          "type": "string",
          "maxLength": 24
        },
        "desc": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "from",
        "to",
        "activity",
        "place",
        "interruptible",
        "priority"
      ],
      "properties": {
        "days": {
          "anyOf": [
            {
              "enum": [
                "daily",
                "weekdays",
                "weekends"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ]
              }
            }
          ]
        },
        "from": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "to": {
          "type": "string",
          "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
        },
        "activity": {
          "enum": [
            "sleep",
            "eat",
            "work",
            "perform",
            "record",
            "train",
            "hustle",
            "socialize",
            "commute",
            "shop",
            "pitch",
            "race",
            "patrol",
            "idle"
          ]
        },
        "place": {
          "$ref": "#/$defs/poi"
        },
        "interruptible": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      }
    },
    "likeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "subjectId",
        "consentRecordId",
        "consentScopes",
        "deceased",
        "faceReferenceAllowed",
        "fameDomain",
        "nameDistanceOk",
        "disclaimer"
      ],
      "properties": {
        "basis": {
          "enum": [
            "real_person",
            "original"
          ]
        },
        "subjectId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^subj_[0-9a-z]{6,40}$"
        },
        "consentRecordId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^consent_[0-9a-z]{8,40}$"
        },
        "consentScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "name",
              "likeness_stylized",
              "likeness_realistic",
              "voice_designed",
              "voice_clone",
              "biography",
              "catchphrases",
              "marketing",
              "merchandise",
              "ugc_remix",
              "cutscene"
            ]
          }
        },
        "deceased": {
          "type": "boolean"
        },
        "faceReferenceAllowed": {
          "type": "boolean"
        },
        "fameDomain": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]{3,32}$"
          }
        },
        "nameDistanceOk": {
          "type": "boolean"
        },
        "disclaimer": {
          "enum": [
            "courtesy",
            "parody",
            "fictional",
            "none"
          ]
        }
      }
    }
  }
}
