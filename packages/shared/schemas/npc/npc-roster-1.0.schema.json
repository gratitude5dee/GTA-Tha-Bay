{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npc-roster-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rosterVersion",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "npc-roster/1"
    },
    "rosterVersion": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "npcId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,47}$"
    },
    "poi": {
      "type": "string",
      "pattern": "^poi\\.[a-z0-9.-]{3,64}$"
    },
    "r10": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "s40x6": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "s40x8": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "s80x6": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "s80x8": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "s80x24": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{3,32}$"
        },
        "name": {
          "type": "string",
          "maxLength": 40
        },
        "input": {
          "type": "string",
          "maxLength": 24
        },
        "desc": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "from",
        "to",
        "activity",
        "place",
        "interruptible",
        "priority"
      ],
      "properties": {
        "days": {
          "anyOf": [
            {
              "enum": [
                "daily",
                "weekdays",
                "weekends"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "mon",
                  "tue",
                  "wed",
                  "thu",
                  "fri",
                  "sat",
                  "sun"
                ]
              }
            }
          ]
        },
        "from": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "to": {
          "type": "string",
          "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
        },
        "activity": {
          "enum": [
            "sleep",
            "eat",
            "work",
            "perform",
            "record",
            "train",
            "hustle",
            "socialize",
            "commute",
            "shop",
            "pitch",
            "race",
            "patrol",
            "idle"
          ]
        },
        "place": {
          "$ref": "#/$defs/poi"
        },
        "interruptible": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      }
    },
    "assetRef": {
      "type": "string",
      "pattern": "^[a-z_]+/[a-z0-9][a-z0-9._-]{1,62}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "soul",
        "status",
        "tier",
        "basis",
        "hero",
        "pipeline",
        "priority",
        "research",
        "standIn",
        "modes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/npcId"
        },
        "soul": {
          "type": "string",
          "pattern": "^content(-private)?/npcs/[a-z0-9_-]+/soul\\.md$"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "retired"
          ]
        },
        "tier": {
          "enum": [
            "consented",
            "parody",
            "fictionalized"
          ]
        },
        "basis": {
          "enum": [
            "real_person",
            "original"
          ]
        },
        "hero": {
          "type": "boolean"
        },
        "pipeline": {
          "enum": [
            "standard",
            "lean",
            "premium",
            "none"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "research": {
          "enum": [
            "none",
            "pending",
            "normalized"
          ]
        },
        "standIn": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^character/[a-z][a-z0-9_-]{2,47}$"
        },
        "modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "story",
              "racing",
              "fighter",
              "tycoon"
            ]
          }
        }
      }
    },
    "soulPublic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "soulVersion",
        "status",
        "origin",
        "name",
        "shortBio",
        "archetype",
        "tags",
        "tier",
        "basis",
        "disclaimer",
        "fameDomain",
        "marketingAllowed",
        "ugcCameo",
        "standIn",
        "heightM",
        "moves",
        "roles",
        "locations",
        "schedule",
        "goals",
        "voice",
        "dialogue",
        "stats",
        "assets"
      ],
      "properties": {
        "schema": {
          "const": "soul-public/1"
        },
        "id": {
          "$ref": "#/$defs/npcId"
        },
        "soulVersion": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "origin": {
          "enum": [
            "first_party",
            "user"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "shortBio": {
          "type": "string",
          "maxLength": 280
        },
        "archetype": {
          "enum": [
            "rapper",
            "founder",
            "vc",
            "influencer",
            "athlete",
            "civilian",
            "police",
            "vendor",
            "official",
            "other"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{2,32}$"
          }
        },
        "tier": {
          "enum": [
            "consented",
            "parody",
            "fictionalized"
          ]
        },
        "basis": {
          "enum": [
            "real_person",
            "original"
          ]
        },
        "disclaimer": {
          "enum": [
            "courtesy",
            "parody",
            "fictional",
            "none"
          ]
        },
        "fameDomain": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]{3,32}$"
          }
        },
        "marketingAllowed": {
          "type": "boolean"
        },
        "ugcCameo": {
          "type": "boolean"
        },
        "standIn": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^character/[a-z][a-z0-9_-]{2,47}$"
        },
        "heightM": {
          "type": "number",
          "minimum": 1.4,
          "maximum": 2.2
        },
        "moves": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hero",
            "questGiver",
            "vendor",
            "fighter",
            "tycoonActor",
            "racer"
          ],
          "properties": {
            "hero": {
              "type": "boolean"
            },
            "questGiver": {
              "type": "boolean"
            },
            "vendor": {
              "type": "boolean"
            },
            "fighter": {
              "type": "boolean"
            },
            "tycoonActor": {
              "type": "boolean"
            },
            "racer": {
              "type": "boolean"
            }
          }
        },
        "locations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "districts",
            "home",
            "hangouts"
          ],
          "properties": {
            "districts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]{2,32}$"
              }
            },
            "home": {
              "$ref": "#/$defs/poi"
            },
            "hangouts": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/poi"
              }
            }
          }
        },
        "schedule": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "goals": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]{3,32}$"
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier",
            "voiceRef",
            "speed"
          ],
          "properties": {
            "tier": {
              "enum": [
                "text",
                "t1",
                "t2",
                "t3"
              ]
            },
            "voiceRef": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^voice/[a-z0-9][a-z0-9._-]{1,62}$"
            },
            "speed": {
              "type": "number",
              "minimum": 0.8,
              "maximum": 1.2
            }
          }
        },
        "dialogue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelTier",
            "maxTurnsPerEncounter"
          ],
          "properties": {
            "modelTier": {
              "enum": [
                "haiku",
                "sonnet"
              ]
            },
            "maxTurnsPerEncounter": {
              "type": "integer",
              "minimum": 4,
              "maximum": 20
            }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fighter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "power",
                "speed",
                "defense",
                "reach",
                "meterGain"
              ],
              "properties": {
                "power": {
                  "$ref": "#/$defs/r10"
                },
                "speed": {
                  "$ref": "#/$defs/r10"
                },
                "defense": {
                  "$ref": "#/$defs/r10"
                },
                "reach": {
                  "$ref": "#/$defs/r10"
                },
                "meterGain": {
                  "$ref": "#/$defs/r10"
                }
              }
            },
            "tycoon": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "riskAppetite",
                "valuationBias",
                "checkUsd"
              ],
              "properties": {
                "riskAppetite": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "valuationBias": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "checkUsd": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "fighter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "style",
            "specials",
            "super",
            "finisher",
            "introQuote",
            "winQuotes",
            "taunts"
          ],
          "properties": {
            "style": {
              "enum": [
                "rushdown",
                "zoner",
                "grappler",
                "all_round",
                "trickster",
                "power"
              ]
            },
            "specials": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/move"
              }
            },
            "super": {
              "$ref": "#/$defs/move"
            },
            "finisher": {
              "$ref": "#/$defs/move"
            },
            "introQuote": {
              "type": "string",
              "maxLength": 120
            },
            "winQuotes": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "maxLength": 120
              }
            },
            "taunts": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        },
        "tycoon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roles",
            "thesis",
            "negotiationStyle",
            "redFlags",
            "pitchHooks"
          ],
          "properties": {
            "roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "founder",
                  "vc",
                  "angel",
                  "exec",
                  "regulator",
                  "journalist"
                ]
              }
            },
            "thesis": {
              "$ref": "#/$defs/s80x8"
            },
            "negotiationStyle": {
              "enum": [
                "hardball",
                "founder_friendly",
                "herd",
                "contrarian"
              ]
            },
            "redFlags": {
              "$ref": "#/$defs/s80x8"
            },
            "pitchHooks": {
              "$ref": "#/$defs/s80x8"
            }
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "rig",
            "anim",
            "portrait",
            "mouthAtlas",
            "voice",
            "ink",
            "barks"
          ],
          "properties": {
            "model": {
              "$ref": "#/$defs/assetRef"
            },
            "rig": {
              "const": "rig/bay_rig_v1"
            },
            "anim": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/assetRef"
              }
            },
            "portrait": {
              "anyOf": [
                {
                  "$ref": "#/$defs/assetRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mouthAtlas": {
              "anyOf": [
                {
                  "$ref": "#/$defs/assetRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "voice": {
              "anyOf": [
                {
                  "$ref": "#/$defs/assetRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ink": {
              "$ref": "#/$defs/assetRef"
            },
            "barks": {
              "anyOf": [
                {
                  "$ref": "#/$defs/assetRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rosterVersion",
        "souls"
      ],
      "properties": {
        "schema": {
          "const": "npc-roster-bundle/1"
        },
        "rosterVersion": {
          "type": "integer",
          "minimum": 1
        },
        "souls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/soulPublic"
          }
        }
      }
    }
  }
}
