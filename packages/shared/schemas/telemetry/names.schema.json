{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tha-bay.invalid/schemas/telemetry/names.schema.json",
  "title": "C16 1.1 per-name telemetry props (M00a subset)",
  "description": "One $defs entry per client telemetry name that has a schema. Names without an entry are dropped at ingest until their emitter milestone adds one. services/edge reads the 'properties' order for blob and double placement: string props go to blobs, number and boolean props to doubles, both in the order listed here.",
  "$defs": {
    "app.start": {
      "type": "object",
      "properties": {
        "nav": {
          "type": "string",
          "maxLength": 32
        },
        "coi": {
          "type": "boolean"
        },
        "store": {
          "enum": [
            "opfs",
            "memory"
          ]
        },
        "backend": {
          "enum": [
            "webgpu",
            "webgl2"
          ]
        },
        "tier": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": [
        "nav",
        "coi",
        "store",
        "backend",
        "tier"
      ],
      "additionalProperties": false
    },
    "app.ready": {
      "type": "object",
      "properties": {
        "nav": {
          "enum": [
            "navigate",
            "reload",
            "back_forward"
          ]
        },
        "bootMs": {
          "type": "number"
        },
        "phaseShellMs": {
          "type": "number"
        },
        "phaseWorldMs": {
          "type": "number"
        }
      },
      "required": [
        "bootMs",
        "phaseShellMs",
        "phaseWorldMs",
        "nav"
      ],
      "additionalProperties": false
    },
    "cutscene.play": {
      "type": "object",
      "properties": {
        "key8": {
          "type": "string",
          "maxLength": 8
        },
        "path": {
          "enum": [
            "video",
            "fallback",
            "instant"
          ]
        },
        "trigger": {
          "enum": [
            "not_ready",
            "not_permitted",
            "media_error",
            "start_stall",
            "mid_stall",
            "codec",
            "budget",
            "policy",
            "offline",
            "degraded_sequence",
            "setting_off"
          ]
        },
        "cached": {
          "type": "boolean"
        },
        "fallback": {
          "type": "boolean"
        }
      },
      "required": [
        "key8",
        "path",
        "cached",
        "fallback"
      ],
      "additionalProperties": false
    },
    "app.hidden": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "app.cold_resume": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "app.abnormal_exit": {
      "type": "object",
      "properties": {
        "prevSid": {
          "type": "string",
          "maxLength": 64
        },
        "scene": {
          "type": "string",
          "maxLength": 64
        },
        "mode": {
          "type": "string",
          "maxLength": 64
        },
        "chunkKey": {
          "type": "string",
          "maxLength": 64
        },
        "cause": {
          "enum": [
            "jetsam",
            "gpu_lost",
            "hang",
            "unknown"
          ]
        },
        "lastBeatAgoMs": {
          "type": "number"
        },
        "memEstMB": {
          "type": "number"
        },
        "gpuEstMB": {
          "type": "number"
        }
      },
      "required": [
        "prevSid",
        "lastBeatAgoMs",
        "scene",
        "mode",
        "chunkKey",
        "memEstMB",
        "gpuEstMB"
      ],
      "additionalProperties": false
    },
    "err.js": {
      "type": "object",
      "properties": {
        "fp": {
          "type": "string",
          "maxLength": 16
        },
        "msg": {
          "type": "string",
          "maxLength": 128
        },
        "top": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "fp",
        "msg",
        "top"
      ],
      "additionalProperties": false
    },
    "err.promise": {
      "type": "object",
      "properties": {
        "fp": {
          "type": "string",
          "maxLength": 16
        },
        "msg": {
          "type": "string",
          "maxLength": 128
        },
        "top": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "fp",
        "msg"
      ],
      "additionalProperties": false
    },
    "err.gpu": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 32
        },
        "msg": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "msg"
      ],
      "additionalProperties": false
    },
    "err.asset": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 32
        },
        "kind": {
          "type": "string",
          "maxLength": 16
        }
      },
      "required": [
        "reason",
        "kind"
      ],
      "additionalProperties": false
    },
    "perf.minute": {
      "type": "object",
      "properties": {
        "fpsP50": {
          "type": "number"
        },
        "fpsP5": {
          "type": "number"
        },
        "frameP95Ms": {
          "type": "number"
        },
        "drawCalls": {
          "type": "number"
        },
        "tris": {
          "type": "number"
        },
        "texMBEst": {
          "type": "number"
        },
        "gpuMBEst": {
          "type": "number"
        },
        "memEstMB": {
          "type": "number"
        }
      },
      "required": [
        "fpsP50",
        "fpsP5",
        "frameP95Ms",
        "drawCalls",
        "tris",
        "texMBEst",
        "gpuMBEst",
        "memEstMB"
      ],
      "additionalProperties": false
    },
    "world.stream": {
      "type": "object",
      "properties": {
        "residentL0": {
          "type": "number"
        },
        "missCount": {
          "type": "number"
        },
        "uploadP95Ms": {
          "type": "number"
        },
        "bytesMB": {
          "type": "number"
        }
      },
      "required": [
        "residentL0",
        "missCount",
        "uploadP95Ms",
        "bytesMB"
      ],
      "additionalProperties": false
    },
    "tier.decision": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "maxLength": 32
        },
        "source": {
          "type": "string",
          "maxLength": 32
        },
        "benchP90Ms": {
          "type": "number"
        }
      },
      "required": [
        "tier",
        "source"
      ],
      "additionalProperties": false
    },
    "storage.persist": {
      "type": "object",
      "properties": {
        "granted": {
          "type": "boolean"
        }
      },
      "required": [
        "granted"
      ],
      "additionalProperties": false
    },
    "pwa.install": {
      "type": "object",
      "properties": {
        "evt": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": [
        "evt"
      ],
      "additionalProperties": false
    },
    "ui.page": {
      "type": "object",
      "properties": {
        "page": {
          "type": "string",
          "maxLength": 32
        },
        "ms": {
          "type": "number"
        }
      },
      "required": [
        "page",
        "ms"
      ],
      "additionalProperties": false
    },
    "ui.onboard": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "maxLength": 32
        },
        "outcome": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": [
        "step",
        "outcome"
      ],
      "additionalProperties": false
    },
    "mode.enter": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "mode.exit": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "maxLength": 64
        },
        "reason": {
          "enum": [
            "completed",
            "quit",
            "failed",
            "parentExit",
            "error",
            "kill"
          ]
        }
      },
      "required": [
        "mode",
        "reason"
      ],
      "additionalProperties": false
    },
    "mission.start": {
      "type": "object",
      "properties": {
        "mid": {
          "type": "string",
          "maxLength": 84
        },
        "stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "sec": {
          "type": "number",
          "minimum": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "mid",
        "stage",
        "sec",
        "attempt"
      ],
      "additionalProperties": false
    },
    "mission.fail": {
      "type": "object",
      "properties": {
        "mid": {
          "type": "string",
          "maxLength": 84
        },
        "reason": {
          "type": "string",
          "maxLength": 96
        },
        "stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "sec": {
          "type": "number",
          "minimum": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "mid",
        "stage",
        "sec",
        "attempt"
      ],
      "additionalProperties": false
    },
    "mission.complete": {
      "type": "object",
      "properties": {
        "mid": {
          "type": "string",
          "maxLength": 84
        },
        "stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "sec": {
          "type": "number",
          "minimum": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "mid",
        "stage",
        "sec",
        "attempt"
      ],
      "additionalProperties": false
    },
    "err.sim": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 32
        },
        "mid": {
          "type": "string",
          "maxLength": 84
        },
        "thread": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "unlock.emit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "racing.start": {
      "type": "object",
      "properties": {
        "raceKind": {
          "enum": [
            "sprint",
            "circuit",
            "checkpoint",
            "speedtrap",
            "downhill",
            "hillclimb",
            "drift",
            "pursuit",
            "sideshow",
            "robotaxiRush"
          ]
        },
        "class": {
          "enum": [
            "D",
            "C",
            "B",
            "A",
            "S",
            "R"
          ]
        },
        "profile": {
          "enum": [
            "local",
            "canonical"
          ]
        }
      },
      "required": [
        "raceKind",
        "class",
        "profile"
      ],
      "additionalProperties": false
    },
    "racing.finish": {
      "type": "object",
      "properties": {
        "raceKind": {
          "enum": [
            "sprint",
            "circuit",
            "checkpoint",
            "speedtrap",
            "downhill",
            "hillclimb",
            "drift",
            "pursuit",
            "sideshow",
            "robotaxiRush"
          ]
        },
        "outcome": {
          "enum": [
            "finish",
            "dnf",
            "quit"
          ]
        },
        "durBucket": {
          "enum": [
            "<60",
            "60-120",
            "120-240",
            "240-480",
            ">480"
          ]
        },
        "place": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "medals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "raceKind",
        "outcome",
        "durBucket",
        "place",
        "medals"
      ],
      "additionalProperties": false
    },
    "quota.block": {
      "type": "object",
      "description": "Server-only (PlayerQuotaDO refusal; never accepted from clients). Props are enums only: no profile id, no net hash.",
      "properties": {
        "kind": {
          "enum": [
            "turn",
            "voice_line",
            "builder_text",
            "builder_job",
            "upload",
            "post",
            "report",
            "play_token",
            "signup"
          ]
        },
        "reason": {
          "enum": [
            "quota",
            "cost_cap",
            "per_npc",
            "net_cap"
          ]
        },
        "scope": {
          "enum": [
            "player",
            "net"
          ]
        },
        "tier": {
          "enum": [
            "local",
            "device",
            "linked"
          ]
        }
      },
      "required": [
        "kind",
        "reason",
        "scope",
        "tier"
      ],
      "additionalProperties": false
    },
    "npc.turn.client": {
      "type": "object",
      "description": "One dialogue turn as the client saw it (M06a3): time to the first text, whether ink took over, and why. No text, no ids.",
      "properties": {
        "ttftMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "fallback": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "timeout",
            "refusal",
            "upstream",
            "invalid_output",
            "killed",
            "moderation",
            "offline",
            "network",
            "setting_off"
          ]
        }
      },
      "required": [
        "ttftMs",
        "fallback"
      ],
      "additionalProperties": false
    },
    "npc.voice.client": {
      "type": "object",
      "description": "One voiced line as the client heard it (M06a4): time from the request of the line to the first audible sample, and the tier that spoke. No text, no ids.",
      "properties": {
        "ttfaMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "tier": {
          "enum": [
            "t1",
            "t2",
            "t3"
          ]
        }
      },
      "required": [
        "ttfaMs",
        "tier"
      ],
      "additionalProperties": false
    },
    "npc.encounter.client": {
      "type": "object",
      "description": "One closed encounter as the client saw it (M06a3). No text, no ids.",
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "fallbacks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "voiceTier": {
          "enum": [
            "text",
            "t1",
            "t2",
            "t3"
          ]
        },
        "model": {
          "enum": [
            "haiku",
            "sonnet",
            "ink"
          ]
        }
      },
      "required": [
        "turns",
        "fallbacks",
        "voiceTier",
        "model"
      ],
      "additionalProperties": false
    },
    "npc.builder.step": {
      "type": "object",
      "description": "One step of the NPC builder finished (M06b1; written by the Worker). Enums only: no draft id, no text.",
      "properties": {
        "step": {
          "enum": [
            "create",
            "validate",
            "soul",
            "probes",
            "preview",
            "private_talk"
          ]
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "step",
        "ok"
      ],
      "additionalProperties": false
    },
    "genai.cost": {
      "type": "object",
      "description": "Server-only (a settled model call; never accepted from clients). Enums and numbers only.",
      "properties": {
        "vendor": {
          "enum": [
            "anthropic",
            "fal",
            "elevenlabs",
            "workers_ai",
            "openai_moderation"
          ]
        },
        "model": {
          "enum": [
            "claude-haiku-5-5",
            "claude-sonnet-5-5",
            "claude-opus-5-5",
            "other"
          ]
        },
        "usdMicros": {
          "type": "integer",
          "minimum": 0
        },
        "cacheHit": {
          "type": "boolean"
        },
        "tier": {
          "enum": [
            "local",
            "device",
            "linked"
          ]
        }
      },
      "required": [
        "vendor",
        "model",
        "usdMicros",
        "cacheHit",
        "tier"
      ],
      "additionalProperties": false
    },
    "fight.end": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "versus",
            "training",
            "story",
            "arcade",
            "replay"
          ]
        },
        "scheme": {
          "enum": [
            "classic",
            "simple"
          ]
        },
        "cpu": {
          "type": "number"
        },
        "rounds": {
          "type": "number"
        },
        "winnerSlot": {
          "type": "number"
        },
        "durationS": {
          "type": "number"
        },
        "pose": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "scheme",
        "cpu",
        "rounds",
        "winnerSlot",
        "durationS",
        "pose"
      ],
      "additionalProperties": false
    },
    "racing.pursuit_end": {
      "type": "object",
      "properties": {
        "heatMax": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "outcome": {
          "enum": [
            "evade",
            "survive",
            "bust",
            "totaled",
            "quit"
          ]
        },
        "durBucket": {
          "enum": [
            "<60",
            "60-120",
            "120-240",
            "240-480",
            ">480"
          ]
        }
      },
      "required": [
        "heatMax",
        "outcome",
        "durBucket"
      ],
      "additionalProperties": false
    },
    "racing.replay_view": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "exact",
            "track"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "racing.verify_fail": {
      "type": "object",
      "description": "A replay that did not re-simulate to its recorded result (M07a2). The enum is the reason; no positions, no ids.",
      "properties": {
        "reason": {
          "enum": [
            "handlingRev",
            "buildId",
            "worldBake",
            "endHash",
            "finishTick",
            "gateTicks",
            "format"
          ]
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "app.crash": {
      "type": "object",
      "description": "A browser crash report received on route 4 (M11a1, C16 1.2, DL-224). Server-only: the reason (Chromium reports oom or unresponsive) and the build; the page path goes to the log line, never to the event.",
      "properties": {
        "reason": {
          "enum": [
            "oom",
            "unresponsive",
            "other"
          ]
        },
        "build": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "reason",
        "build"
      ],
      "additionalProperties": false
    }
  }
}
