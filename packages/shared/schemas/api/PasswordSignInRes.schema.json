{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "user": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "username": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "username"
          ],
          "additionalProperties": false
        },
        "session": {
          "type": "object",
          "properties": {
            "accessToken": {
              "type": "string"
            },
            "expiresIn": {
              "type": "number"
            }
          },
          "required": [
            "accessToken",
            "expiresIn"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "user",
        "session"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "exp": {
          "type": "number"
        },
        "refreshToken": {
          "type": "string"
        },
        "refreshExp": {
          "type": "number"
        },
        "state": {
          "type": "object",
          "properties": {
            "profileId": {
              "type": "string"
            },
            "tier": {
              "type": "string",
              "enum": [
                "local",
                "device",
                "linked"
              ]
            },
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "linkedAt": {
                    "type": "number"
                  }
                },
                "required": [
                  "id",
                  "linkedAt"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "profileId",
            "tier",
            "providers"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "accessToken",
        "exp",
        "refreshToken",
        "refreshExp",
        "state"
      ],
      "additionalProperties": false
    }
  ],
  "definitions": {}
}
