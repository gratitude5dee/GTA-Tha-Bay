{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "pending",
        "absent",
        "failed",
        "blocked"
      ]
    },
    "manifestUrl": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "not_in_catalog",
        "kill_switched",
        "budget",
        "region"
      ]
    }
  },
  "required": [
    "key",
    "state"
  ],
  "additionalProperties": false,
  "definitions": {}
}
