{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "accessToken": {
      "type": "string"
    },
    "exp": {
      "type": "number"
    },
    "refreshToken": {
      "type": "string"
    },
    "refreshExp": {
      "type": "number"
    },
    "state": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "local",
            "device",
            "linked"
          ]
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "linkedAt": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "linkedAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "profileId",
        "tier",
        "providers"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "accessToken",
    "exp",
    "refreshToken",
    "refreshExp",
    "state"
  ],
  "additionalProperties": false,
  "definitions": {}
}
