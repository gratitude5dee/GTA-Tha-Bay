{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "all",
          "spawn",
          "fighter",
          "cutscene",
          "voice",
          "marketing",
          "ugc"
        ]
      }
    },
    "reason": {
      "type": "string",
      "enum": [
        "consent_revoked",
        "complaint",
        "legal",
        "safety",
        "quality"
      ]
    },
    "ticketId": {
      "type": "string"
    },
    "standIn": {
      "type": "string"
    }
  },
  "required": [
    "scope",
    "reason",
    "ticketId"
  ],
  "additionalProperties": false,
  "definitions": {}
}
