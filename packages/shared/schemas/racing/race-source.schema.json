{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tha-bay.dev/schemas/racing/race-source.schema.json",
  "title": "content/races/<id>/source.json (RaceSource, schema 1; 06-racing-data.md 4.2)",
  "description": "What a race author writes: lat/lng or landmark waypoints and the event rules. `pnpm map:races compile` snaps it to the baked road graph and writes race.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "kind", "titleKey", "district", "waypoints", "traffic", "peds", "opponents", "police", "rubberBand", "rewards", "xr"],
  "$defs": {
    "latlng": {
      "type": "object", "additionalProperties": false, "required": ["lat", "lng"],
      "properties": { "lat": { "type": "number", "minimum": -90, "maximum": 90 }, "lng": { "type": "number", "minimum": -180, "maximum": 180 } }
    },
    "landmark": {
      "type": "object", "additionalProperties": false, "required": ["landmark"],
      "properties": { "landmark": { "type": "string", "pattern": "^lm\\.[a-z0-9-]+$" } }
    },
    "point": { "oneOf": [{ "$ref": "#/$defs/latlng" }, { "$ref": "#/$defs/landmark" }] },
    "heat": { "type": "integer", "minimum": 0, "maximum": 6 },
    "class": { "enum": ["D", "C", "B", "A", "S", "R"] }
  },
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^sf\\.[a-z]+\\.[a-z0-9-]{3,40}$" },
    "version": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["sprint", "circuit", "checkpoint", "speedtrap", "downhill", "hillclimb", "drift", "pursuit", "sideshow", "robotaxiRush"] },
    "titleKey": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_.-]{2,80}$" },
    "district": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
    "waypoints": { "type": "array", "minItems": 2, "maxItems": 64, "items": { "$ref": "#/$defs/point" } },
    "via": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/point" } },
    "laps": { "type": "integer", "minimum": 1, "maximum": 9 },
    "closedLoop": { "type": "boolean" },
    "gateOverrides": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["at"],
        "properties": {
          "at": { "$ref": "#/$defs/point" }, "widthM": { "type": "number", "minimum": 4, "maximum": 40 },
          "timeBonusSec": { "type": "number", "minimum": 0, "maximum": 120 }, "speedCam": { "type": "boolean" }, "remove": { "type": "boolean" }
        }
      }
    },
    "closures": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["at", "propSet"],
        "properties": { "at": { "$ref": "#/$defs/point" }, "propSet": { "enum": ["barrier-line", "cones-line", "construction"] } }
      }
    },
    "zones": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "ring", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" }, "kind": { "enum": ["drift", "sideshow", "finish"] },
          "ring": { "type": "array", "minItems": 3, "maxItems": 32, "items": { "$ref": "#/$defs/point" } }
        }
      }
    },
    "hour": { "type": "number", "minimum": 0, "maximum": 24 },
    "weather": { "enum": ["clear", "karl-fog", "overcast", "rain", "smoke", "golden"] },
    "traffic": { "enum": ["off", "light", "normal"] },
    "peds": { "const": "sidewalk" },
    "opponents": {
      "type": "array", "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["driverId", "vehicleDef", "skill"],
        "properties": {
          "driverId": { "type": "string", "pattern": "^[a-z0-9.-]{3,40}$" }, "vehicleDef": { "type": "string", "pattern": "^vehicle\\.[a-z0-9-]+$" },
          "skill": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "classLimit": { "type": "array", "items": { "$ref": "#/$defs/class" }, "minItems": 1 },
    "loaner": { "type": "string", "pattern": "^vehicle\\.[a-z0-9-]+$" },
    "police": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "startHeat", "maxHeat"],
      "properties": {
        "enabled": { "type": "boolean" }, "startHeat": { "$ref": "#/$defs/heat" }, "maxHeat": { "$ref": "#/$defs/heat" },
        "roadblocks": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["atS", "kind", "minHeat", "gapM"],
            "properties": {
              "atS": { "type": "number", "minimum": 0 }, "kind": { "enum": ["roadblock2", "roadblockHeavy", "spikes"] },
              "minHeat": { "$ref": "#/$defs/heat" }, "gapM": { "type": "number", "minimum": 2 }
            }
          }
        },
        "success": {
          "oneOf": [
            { "const": "evade" },
            { "type": "object", "additionalProperties": false, "required": ["surviveSec"], "properties": { "surviveSec": { "type": "number", "minimum": 10 } } }
          ]
        }
      }
    },
    "rubberBand": { "type": "number", "minimum": 0, "maximum": 1 },
    "rewards": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": {
          "kind": { "enum": ["cash", "rep", "vehicle", "unlock", "item"] }, "place": { "type": "integer", "minimum": 1, "maximum": 8 },
          "cents": { "type": "integer", "minimum": 0 }, "rep": { "type": "integer", "minimum": 0 }, "ref": { "type": "string", "maxLength": 80 },
          "firstTimeOnly": { "type": "boolean" }
        }
      }
    },
    "unlocks": { "type": "array", "items": { "type": "string", "pattern": "^unlock\\.[a-z0-9._]{1,60}$" } },
    "xr": { "enum": ["full", "none"] },
    "hidingSpots": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["at", "radiusM"],
        "properties": { "at": { "$ref": "#/$defs/point" }, "radiusM": { "type": "number", "minimum": 5, "maximum": 80 } }
      }
    },
    "story": {
      "type": "object", "additionalProperties": false, "required": ["hookId"],
      "properties": { "hookId": { "type": "string", "pattern": "^[a-z0-9.]{3,40}$" } }
    }
  }
}
