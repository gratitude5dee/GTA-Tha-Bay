{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sandbox-catalog-1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rows"],
  "properties": {
    "schema": { "const": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefab", "nameKey"],
        "properties": {
          "prefab": { "type": "string", "pattern": "^vehicle\\.[a-z0-9-]{1,48}$" },
          "nameKey": { "type": "string", "pattern": "^sandbox\\.car\\.[a-z0-9-]{1,48}$" }
        }
      }
    }
  }
}
