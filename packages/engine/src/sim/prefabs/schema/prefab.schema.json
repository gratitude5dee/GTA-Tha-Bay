{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tha-bay.dev/schemas/prefab.schema.json",
  "title": "assets/prefabs/<id>.json (C01 entity prefab, PrefabDef)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "version", "render", "physics", "components"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$", "description": "Dotted lower-case id, for example player.default; a segment may hold hyphens (prop.county-barrier, M02c1)." },
    "kind": { "enum": ["player", "vehicle", "ped", "prop", "pickup", "police", "robotaxi", "portal", "marker", "trigger"] },
    "version": { "type": "integer", "minimum": 1 },
    "nameKey": { "type": "string", "minLength": 1, "description": "NameRegistry key; never a raw brand." },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset"],
      "properties": {
        "asset": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*/[A-Za-z0-9._-]+$", "description": "C07 AssetRef '<kind>/<id>'." },
        "variants": { "type": "integer", "minimum": 1, "maximum": 255 },
        "anim": { "type": "string", "minLength": 1 }
      }
    },
    "physics": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["body", "shape", "dims", "groups"],
          "properties": {
            "body": { "enum": ["dynamic", "kinematic", "fixed"] },
            "shape": { "enum": ["capsule", "box", "sphere", "convex"] },
            "dims": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 1 },
            "massKg": { "type": "number", "exclusiveMinimum": 0 },
            "liftM": { "type": "number", "minimum": 0, "description": "Metres the body centre starts above the placement point." },
            "friction": { "type": "number", "minimum": 0 },
            "restitution": { "type": "number", "minimum": 0, "maximum": 1 },
            "linearDamping": { "type": "number", "minimum": 0 },
            "angularDamping": { "type": "number", "minimum": 0 },
            "ccd": { "type": "boolean" },
            "groups": {
              "type": "array",
              "items": { "enum": ["static", "dynamic", "character", "vehicle", "kinematic", "sensor"] },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "components": {
      "type": "object",
      "description": "ComponentDef name to default field values. A string value is interned in the string table.",
      "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*(\\.[0-9]+)?$" },
        "additionalProperties": { "anyOf": [{ "type": "number" }, { "type": "string" }] }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handling", "seats", "wheels"],
      "properties": {
        "handling": { "type": "string", "pattern": "^hp\\.[a-z0-9]+(-[a-z0-9]+)*$", "description": "HandlingProfile id (S06)." },
        "seats": { "type": "integer", "minimum": 1, "maximum": 8 },
        "wheels": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["pos", "radius", "restM", "axle"],
            "properties": {
              "pos": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "radius": { "type": "number", "exclusiveMinimum": 0 },
              "restM": { "type": "number", "exclusiveMinimum": 0 },
              "axle": { "enum": ["front", "rear"] }
            }
          }
        },
        "quirks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "interact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "radius", "promptKey"],
      "properties": {
        "kind": { "enum": ["EnterVehicle", "Talk", "Pickup", "Door", "Shop", "SafehouseSave", "MissionStart", "ModeEntry", "Experience", "Respray", "Transit", "Generic"] },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "promptKey": { "type": "string", "minLength": 1 },
        "coneDeg": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
        "priority": { "type": "integer", "minimum": -128, "maximum": 127 },
        "hold": { "type": "boolean" }
      }
    },
    "audio": { "type": "object", "required": ["set"], "properties": { "set": { "type": "string" } } }
  }
}
