{
  "name": "@dv/engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sim": "./src/sim/index.ts",
    "./headless": "./src/headless/index.ts",
    "./platform": "./src/platform/index.ts",
    "./platform/probe": "./src/platform/probe.ts",
    "./platform/renderer-host": "./src/platform/renderer-host.ts",
    "./platform/bomb-gpu": "./src/platform/perf/bomb-gpu.ts",
    "./client/boot": "./src/client/boot/boot-engine.ts",
    "./client/debug/bridge": "./src/client/debug/bridge.ts",
    "./client/save-status": "./src/client/save-status.ts",
    "./save": "./src/sim/save/index.ts",
    "./assets/bridge": "./src/assets/bridge.ts",
    "./client/boot/spawn-worker": "./src/client/boot/spawn-worker.ts",
    "./client/boot/world-layer": "./src/client/boot/world-layer.ts",
    "./client/anim": "./src/client/anim/placeholder-rig.ts",
    "./assets/service": "./src/assets/service.ts",
    "./assets/client": "./src/assets/client.ts",
    "./assets/spawn": "./src/assets/spawn.ts",
    "./assets/types": "./src/assets/store/types.ts",
    "./workers/asset-core": "./src/workers/asset-core.ts",
    "./workers/sim-worker-core": "./src/workers/sim-worker-core.ts",
    "./platform/perf": "./src/platform/perf/scenario-runner.ts",
    "./platform/tier-config": "./src/platform/tier-config.ts"
  },
  "scripts": {
    "test": "tsx ../../tools/ci/run.ts vitest --pkg packages/engine",
    "test:lint-bans": "tsx ../../tools/ci/run.ts vitest --pkg packages/engine lint.bans.spec",
    "test:headless": "tsx ../../tools/ci/run.ts vitest --pkg packages/engine headless.noDom.spec",
    "test:save": "tsx ../../tools/ci/run.ts vitest --pkg packages/engine save/",
    "test:determinism": "tsx ../../tools/ci/run.ts vitest --pkg packages/engine determinism.node.spec",
    "test:lines": "tsx ../../tools/ci/run.ts vitest run packages/engine/test/vehicle.lines.spec.ts packages/engine/test/lines.format.spec.ts",
    "test:wheel-spike": "tsx ../../tools/ci/run.ts vitest run packages/engine/test/wheel-spike",
    "bench:physics": "tsx bench/physics-builds.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "@dimforge/rapier3d-simd-compat": "0.21.0",
    "@dv/shared": "workspace:*",
    "bitecs": "0.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "fake-indexeddb": "^6.2.6",
    "iwer": "2.6.0"
  }
}
