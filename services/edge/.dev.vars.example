# Names only; copy to .dev.vars (git-ignored) and fill in values. Never commit values.
# PLAY_TOKEN_HMAC = "<kid>:<base64url of 32 random bytes>", e.g. "k1:" + `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`
PLAY_TOKEN_HMAC=
# PLAY_TOKEN_HMAC_PREV=
SUPABASE_SECRET_KEY=
OPS_TOKEN=
FAL_KEY=
# M06a1: salts the daily network hash of the per-net caps (any random string; absent: the UTC day alone, which still works locally)
QUOTA_NET_SALT_SECRET=
# M06a3: `pnpm dev` already runs the Worker on recorded streams (--var ANTHROPIC_MODE:fixture). For `pnpm dev:edge`, or to call the real model, set these
# (.dev.vars overrides the wrangler vars). Live mode needs the key of the Anthropic workspace npc-runtime; AIG_BASE is the gateway gw-dialogue, unset = direct API.
# ANTHROPIC_MODE=fixture
# FLAGS_JSON={"npc.dialogue":true}
ANTHROPIC_API_KEY=
# AIG_BASE=
