// tha-bay-web: static assets plus /api/v1/* (M00a). Navigation stays on the asset path (run_worker_first covers /api/* and /account, which redirects to /account/; M00e).
// Never touch, rename or deploy over a Worker whose name does not start with tha-bay-.
// Bindings, vars and define are not inherited by env.staging or previews and are repeated on purpose.
// Keys marked (dagger) in the spec were checked with `wrangler deploy --dry-run` on wrangler 4.151.1: see spec/03 and spec/99 U-BE-3.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tha-bay-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/account", "/media/*"]
  },
  // No custom domain until Q-15 is answered.
  "workers_dev": true,
  // Durable Objects (M05b1). Class lifecycle changes ship alone through `wrangler deploy` (check:do-migrations, label do-lifecycle).
  "durable_objects": {
    "bindings": [
      { "name": "CUTSCENE_JOB", "class_name": "CutsceneJobDO" },
      { "name": "FAL_GATE", "class_name": "FalGateDO" },
      { "name": "GOVERNOR", "class_name": "BudgetGovernorDO" },
      { "name": "ENCOUNTER", "class_name": "EncounterDO" },
      { "name": "QUOTA", "class_name": "PlayerQuotaDO" },
      // The Transcoder Container (M05c3): ffmpeg ladder cut@1 and the C2PA re-signer, one instance per cutscene key.
      { "name": "TRANSCODER", "class_name": "TranscoderContainer" }
    ]
  },
  "migrations": [
    { "tag": "web-v1", "new_sqlite_classes": ["CutsceneJobDO", "FalGateDO", "BudgetGovernorDO"] },
    { "tag": "web-v2", "new_sqlite_classes": ["EncounterDO", "PlayerQuotaDO"] },
    { "tag": "web-v3", "new_sqlite_classes": ["TranscoderContainer"] }
  ],
  // No Docker daemon is needed for local dev, tests or bundling: mock mode uses MockTranscodePort (wrangler dev / getPlatformProxy).
  "dev": { "enable_containers": false },
  // Container application bound to the DO class above (wrangler 4.151.1 schema: ContainerApp; spec/03 section 7, U-BE-3).
  "containers": [
    { "name": "tha-bay-transcoder", "class_name": "TranscoderContainer", "image": "../pipeline/transcoder/Dockerfile", "instance_type": "standard-2", "max_instances": 4 }
  ],
  // Media and private buckets, the FLAGS namespace (kill switches, gov:level) and the gen-job Workflow (M05b1).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tha-bay-media-prod" },
    { "binding": "PRIVATE", "bucket_name": "tha-bay-private-prod" }
  ],
  "kv_namespaces": [{ "binding": "FLAGS", "id": "c97c407d70c8457083bf0865b82c27fe" }],
  "workflows": [{ "name": "gen-job", "binding": "GEN_WF", "class_name": "GenJobWorkflow" }],
  // Queues (M06a1): JOBS carries summarize, forget and export; SPEND carries settled turn costs into BudgetGovernorDO. Created by deploy:bootstrap.
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "tha-bay-jobs" },
      { "binding": "SPEND", "queue": "tha-bay-spend" }
    ],
    "consumers": [
      { "queue": "tha-bay-jobs", "max_batch_size": 50 },
      { "queue": "tha-bay-spend", "max_batch_size": 100, "max_batch_timeout": 5 }
    ]
  },
  "analytics_engine_datasets": [{ "binding": "AE", "dataset": "tha_bay_telemetry" }],
  // Workers AI (M06a4): bge-m3 embeddings for NPC memory and Aura text-to-speech. No key; the binding is remote even under wrangler dev.
  "ai": { "binding": "AI" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.25, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // src/routes/test.ts is imported only inside `if (__DV_TEST_ROUTES__)`, so the prod bundle drops it.
  "define": { "__DV_TEST_ROUTES__": "false" },
  "vars": {
    "ENVIRONMENT": "prod",
    "GEO_ALLOW": "US",
    "BUILD_ID": "dev",
    "MIN_CLIENT_BUILD": "0",
    "HOST_API": "https://tha-bay-web.gratitude-8f4.workers.dev",
    "HOST_RT": "https://tha-bay-rooms.gratitude-8f4.workers.dev",
    "HOST_ID": "https://tha-bay-web.gratitude-8f4.workers.dev",
    // The Worker's own media route (M01d2, DL-713); a media.<domain> replaces it after Q-15.
    "HOST_MEDIA": "https://tha-bay-web.gratitude-8f4.workers.dev/media",
    // Kill switch of /media/*: "off" answers 503 (DL-713).
    "MEDIA_ROUTE": "on",
    // placeholder until Q-15: R2 custom domain, no workers.dev form
    "HOST_UGC": "https://tha-bay-ugc.workers.dev",
    // Dialogue stays off in production until the operator flips npc.dialogue with route 47 (after M06a5). Mode must be "live" here (check:prod-routes).
    "FLAGS_JSON": "{}",
    "ANTHROPIC_MODE": "live",
    // AIG_BASE (AI Gateway gw-dialogue, https://gateway.ai.cloudflare.com/v1/<account>/gw-dialogue/anthropic) is set by the operator once the gateway exists;
    // unset, calls go to the Anthropic API directly (U-NPC-02 fallback). AIG_ENV is optional ("synthetic" for the M14b1 T4 run).
    "FAL_MODE": "live",
    // Renditions are re-signed with our C2PA claim in production (ADR-GENAI-01 G4, M05c3); "0" in staging and previews. Absent means on.
    "C2PA_RESIGN": "1",
    // Supabase project tha-bay (us-west-1): URL and anon/publishable key are public by design.
    // Service-role key rides as the SUPABASE_SECRET_KEY secret; FAL_KEY as a secret.
    "SUPABASE_URL": "https://jwvvllhxuvwkrynmnchb.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_SLW2rR4klluMCMhS5Mey1g_1XTZ_Oar",
    // Password sign-up switch (M00e, DL-601): "off" in production until the operator sets it "on" by a one-line PR.
    // Sign-in, refresh, logout and me do not depend on it.
    "AUTH_PASSWORD_SIGNUP": "off"
  },
  // Rate Limiting (M00e): class auth of 09-backend-ops.md section 3.1. Namespace ids are unique per environment (BD-M00e-01).
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "7301", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_AUTH_USER", "namespace_id": "7302", "simple": { "limit": 5, "period": 60 } },
    // Class talk (M06a3): 4 turns per 10 s per player; spam control only, the quotas are exact.
    { "name": "RL_TALK", "namespace_id": "7303", "simple": { "limit": 4, "period": 10 } }
  ],
  // The service-path database key (M05d). Required where the Worker is deployed; local dev and tests run without it (no database: the static fallback applies).
  // PLAY_TOKEN_HMAC is first required here (M04b3 left it out, DL-679); a version upload without it fails instead of skipping.
  "secrets": { "required": ["SUPABASE_SECRET_KEY", "PLAY_TOKEN_HMAC", "QUOTA_NET_SALT_SECRET", "ANTHROPIC_API_KEY"] },
  // 03:10 UTC catalog-sync, ledger-export, transcript retention; 03:20 memory retention; 03:30 stub profiles (M05d, M06a1).
  // Previews run no Cron Triggers; /api/v1/_test/run-scheduled stands in there.
  "triggers": { "crons": ["10 3 * * *", "20 3 * * *", "30 3 * * *"] },
  "env": {
    "staging": {
      "name": "tha-bay-web-staging",
      "main": "src/index.ts",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "../../apps/web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/account", "/media/*"]
      },
      // Durable Objects (M05b1). Class lifecycle changes ship alone through `wrangler deploy` (check:do-migrations, label do-lifecycle).
      "durable_objects": {
        "bindings": [
          { "name": "CUTSCENE_JOB", "class_name": "CutsceneJobDO" },
          { "name": "FAL_GATE", "class_name": "FalGateDO" },
          { "name": "GOVERNOR", "class_name": "BudgetGovernorDO" },
          { "name": "ENCOUNTER", "class_name": "EncounterDO" },
          { "name": "QUOTA", "class_name": "PlayerQuotaDO" }
        ]
      },
      "migrations": [
        { "tag": "web-v1", "new_sqlite_classes": ["CutsceneJobDO", "FalGateDO", "BudgetGovernorDO"] },
        { "tag": "web-v2", "new_sqlite_classes": ["EncounterDO", "PlayerQuotaDO"] }
      ],
      // Media and private buckets, the FLAGS namespace (kill switches, gov:level) and the gen-job Workflow (M05b1).
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "tha-bay-media-staging" },
        { "binding": "PRIVATE", "bucket_name": "tha-bay-private-staging" }
      ],
      "kv_namespaces": [{ "binding": "FLAGS", "id": "cc3f7d4eeac748c59dfec0a88ab181f4" }],
      "workflows": [{ "name": "gen-job-staging", "binding": "GEN_WF", "class_name": "GenJobWorkflow" }],
      "queues": {
        "producers": [
          { "binding": "JOBS", "queue": "tha-bay-jobs-staging" },
          { "binding": "SPEND", "queue": "tha-bay-spend-staging" }
        ],
        "consumers": [
          { "queue": "tha-bay-jobs-staging", "max_batch_size": 50 },
          { "queue": "tha-bay-spend-staging", "max_batch_size": 100, "max_batch_timeout": 5 }
        ]
      },
      // ANTHROPIC_API_KEY is not required in staging: it runs ANTHROPIC_MODE=fixture. Add it here when staging goes live (M06a3 AC-12).
      "secrets": { "required": ["SUPABASE_SECRET_KEY", "PLAY_TOKEN_HMAC", "QUOTA_NET_SALT_SECRET"] },
      "triggers": { "crons": ["10 3 * * *", "20 3 * * *", "30 3 * * *"] },
      "analytics_engine_datasets": [{ "binding": "AE", "dataset": "tha_bay_telemetry" }],
      "ai": { "binding": "AI" },
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1.0, "invocation_logs": true },
        "traces": { "enabled": true, "head_sampling_rate": 1.0 }
      },
      "define": { "__DV_TEST_ROUTES__": "true" },
      "vars": {
        "ENVIRONMENT": "staging",
        "GEO_ALLOW": "US",
        "BUILD_ID": "dev",
        "MIN_CLIENT_BUILD": "0",
        "HOST_API": "https://tha-bay-web-staging.gratitude-8f4.workers.dev",
        "HOST_RT": "https://tha-bay-rooms-staging.gratitude-8f4.workers.dev",
        "HOST_ID": "https://tha-bay-web-staging.gratitude-8f4.workers.dev",
        // The Worker's own media route (M01d2, DL-713); a media.<domain> replaces it after Q-15.
        "HOST_MEDIA": "https://tha-bay-web-staging.gratitude-8f4.workers.dev/media",
        "MEDIA_ROUTE": "on",
        // placeholder until Q-15: R2 custom domain, no workers.dev form
        "HOST_UGC": "https://tha-bay-ugc-staging.workers.dev",
        // npc.dialogue is on in staging; recorded streams answer until the operator sets ANTHROPIC_MODE=live and the key.
        "FLAGS_JSON": "{\"npc.dialogue\":true}",
        "ANTHROPIC_MODE": "fixture",
        "FAL_MODE": "mock",
        "C2PA_RESIGN": "0",
        "SUPABASE_URL": "https://jwvvllhxuvwkrynmnchb.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_SLW2rR4klluMCMhS5Mey1g_1XTZ_Oar",
        // Owner testing: staging sign-up is open. Route 58 also needs LEGAL_CONTACT (operator-supplied, not set here; DL-635).
        "AUTH_PASSWORD_SIGNUP": "on"
      },
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "7311", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_AUTH_USER", "namespace_id": "7312", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_TALK", "namespace_id": "7313", "simple": { "limit": 4, "period": 10 } }
      ]
    }
  },
  // Required by `wrangler preview`. Bindings are not inherited and are repeated here.
  // `previews.assets` is rejected by wrangler 4.151.1 ("Unexpected fields found in previews field"); assets come from the --env staging config.
  "previews": {
    // Durable Objects (M05b1). Class lifecycle changes ship alone through `wrangler deploy` (check:do-migrations, label do-lifecycle).
    "durable_objects": {
      "bindings": [
        { "name": "CUTSCENE_JOB", "class_name": "CutsceneJobDO" },
        { "name": "FAL_GATE", "class_name": "FalGateDO" },
        { "name": "GOVERNOR", "class_name": "BudgetGovernorDO" },
        { "name": "ENCOUNTER", "class_name": "EncounterDO" },
        { "name": "QUOTA", "class_name": "PlayerQuotaDO" }
      ]
    },
    // previews take no `migrations` key (wrangler 4.151.1 rejects it); the DO classes migrate through the staging deploy.
    // Media and private buckets, the FLAGS namespace (kill switches, gov:level) and the gen-job Workflow (M05b1).
    "r2_buckets": [
      { "binding": "MEDIA", "bucket_name": "tha-bay-media-staging" },
      { "binding": "PRIVATE", "bucket_name": "tha-bay-private-staging" }
    ],
    "kv_namespaces": [{ "binding": "FLAGS", "id": "cc3f7d4eeac748c59dfec0a88ab181f4" }],
    "workflows": [{ "name": "gen-job-staging", "binding": "GEN_WF", "class_name": "GenJobWorkflow", "script_name": "tha-bay-web-staging" }],
    // Producers only: Previews run no queue consumers (F-061); /api/v1/_test/drain-queue and the inline paths of the routes stand in.
    "queues": {
      "producers": [
        { "binding": "JOBS", "queue": "tha-bay-jobs-staging" },
        { "binding": "SPEND", "queue": "tha-bay-spend-staging" }
      ]
    },
    "analytics_engine_datasets": [{ "binding": "AE", "dataset": "tha_bay_telemetry" }],
    "ai": { "binding": "AI" },
    "define": { "__DV_TEST_ROUTES__": "true" },
    "vars": {
      "ENVIRONMENT": "preview",
      "GEO_ALLOW": "US",
      "BUILD_ID": "dev",
      "MIN_CLIENT_BUILD": "0",
      "HOST_API": "https://tha-bay-web-staging.gratitude-8f4.workers.dev",
      "HOST_RT": "https://tha-bay-rooms-staging.gratitude-8f4.workers.dev",
      "HOST_ID": "https://tha-bay-web-staging.gratitude-8f4.workers.dev",
      // The Worker's own media route (M01d2, DL-713); a media.<domain> replaces it after Q-15.
      "HOST_MEDIA": "https://tha-bay-web-staging.gratitude-8f4.workers.dev/media",
      "MEDIA_ROUTE": "on",
      // placeholder until Q-15: R2 custom domain, no workers.dev form
      "HOST_UGC": "https://tha-bay-ugc-staging.workers.dev",
      "FLAGS_JSON": "{\"npc.dialogue\":true}",
      "ANTHROPIC_MODE": "fixture",
      "FAL_MODE": "mock",
      "C2PA_RESIGN": "0"
      // No SUPABASE_URL, SUPABASE_ANON_KEY or AUTH_PASSWORD_SIGNUP: routes 58-62, 64 and 65 answer feature_disabled in previews (M00e, DL-601).
      // M05d: SKIP staging Supabase vars: publishable key not provided (tha-bay-staging does not exist yet). When the operator adds it to
      // config/supabase.projects.json, previews and env.staging take its URL and key here and boot.test.ts AC-6 asserts them.
    },
    "ratelimits": [
      { "name": "RL_AUTH", "namespace_id": "7321", "simple": { "limit": 10, "period": 60 } },
      { "name": "RL_AUTH_USER", "namespace_id": "7322", "simple": { "limit": 5, "period": 60 } },
      { "name": "RL_TALK", "namespace_id": "7323", "simple": { "limit": 4, "period": 10 } }
    ]
  }
}
