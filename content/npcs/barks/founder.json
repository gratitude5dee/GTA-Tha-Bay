    {"id":"fnd-heat-low-1","tag":"heat_low","text":"Regulatory risk, I knew it.","audio":null,"cues":null,"weight":1},
    {"id":"fnd-heat-low-2","tag":"heat_low","text":"I will add that to the risk slide.","audio":null,"cues":null,"weight":1},
    {"id":"fnd-heat-high-1","tag":"heat_high","text":"This is not covered by my runway.","audio":null,"cues":null,"weight":1},
