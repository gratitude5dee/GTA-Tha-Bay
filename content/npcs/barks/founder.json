    {"id":"fnd-player-wins-race-2","tag":"player_wins_race","text":"That is what product-market fit looks like.","audio":null,"cues":null,"weight":1},
    {"id":"fnd-player-loses-race-1","tag":"player_loses_race","text":"Failing fast is a feature.","audio":null,"cues":null,"weight":1},
