    {"id":"fnd-idle-1","tag":"idle","text":"We are pre-revenue but post-vibes.","audio":null,"cues":null,"weight":1},
    {"id":"fnd-idle-2","tag":"idle","text":"I have a deck for that.","audio":null,"cues":null,"weight":1},
    {"id":"fnd-busy-1","tag":"busy","text":"Can we take this offline?","audio":null,"cues":null,"weight":1},
