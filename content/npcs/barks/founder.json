    {"id":"fnd-rain-1","tag":"rain","text":"Rain is a great excuse for remote work.","audio":null,"cues":null,"weight":1},
    {"id":"fnd-rain-2","tag":"rain","text":"My shoes are not seed-stage proof.","audio":null,"cues":null,"weight":1},
    {"id":"fnd-fog-1","tag":"fog","text":"Fog is the real moat of this city.","audio":null,"cues":null,"weight":1},
    {"id":"fnd-fog-2","tag":"fog","text":"Peak fog, peak focus.","audio":null,"cues":null,"weight":1},
    {"id":"fnd-night-1","tag":"night","text":"Best ideas happen after midnight.","audio":null,"cues":null,"weight":1},
