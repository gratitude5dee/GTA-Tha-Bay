    {"id":"pol-fog-1","tag":"fog","text":"Visibility is poor, slow down.","audio":null,"cues":null,"weight":1},
    {"id":"pol-fog-2","tag":"fog","text":"Fog advisory, lights on.","audio":null,"cues":null,"weight":1},
    {"id":"pol-night-1","tag":"night","text":"Curfew is for suggestions, not rules.","audio":null,"cues":null,"weight":1},
