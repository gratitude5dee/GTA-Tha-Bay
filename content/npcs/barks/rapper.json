  "lines": [
    {"id":"rap-bump-1","tag":"bump","text":"Easy, easy, you are messing with my flow.","audio":null,"cues":null,"weight":1},
    {"id":"rap-bump-2","tag":"bump","text":"Watch the fit, fam.","audio":null,"cues":null,"weight":1},
    {"id":"rap-greet-pass-1","tag":"greet_pass","text":"What up, what up.","audio":null,"cues":null,"weight":1},
    {"id":"rap-greet-pass-2","tag":"greet_pass","text":"Yo, you good?","audio":null,"cues":null,"weight":1},
    {"id":"rap-idle-1","tag":"idle","text":"Working on a verse, hold on.","audio":null,"cues":null,"weight":1},
    {"id":"rap-idle-2","tag":"idle","text":"Beat is in my head, nothing else.","audio":null,"cues":null,"weight":1},
    {"id":"rap-busy-1","tag":"busy","text":"In the booth later, catch me then.","audio":null,"cues":null,"weight":1},
    {"id":"rap-busy-2","tag":"busy","text":"Studio time is money.","audio":null,"cues":null,"weight":1},
    {"id":"rap-flee-1","tag":"flee","text":"Not tonight, not tonight!","audio":null,"cues":null,"weight":1},
    {"id":"rap-flee-2","tag":"flee","text":"I am out!","audio":null,"cues":null,"weight":1},
    {"id":"rap-car-crash-nearby-1","tag":"car_crash_nearby","text":"That sound was not on my track.","audio":null,"cues":null,"weight":1},
    {"id":"rap-car-crash-nearby-2","tag":"car_crash_nearby","text":"Somebody is having a worse day.","audio":null,"cues":null,"weight":1},
    {"id":"rap-heat-low-1","tag":"heat_low","text":"Sirens are the best percussion.","audio":null,"cues":null,"weight":1},
    {"id":"rap-heat-low-2","tag":"heat_low","text":"Heat is on the block again.","audio":null,"cues":null,"weight":1},
    {"id":"rap-heat-high-1","tag":"heat_high","text":"Too much noise for one night.","audio":null,"cues":null,"weight":1},
    {"id":"rap-heat-high-2","tag":"heat_high","text":"Keep it low, keep it quiet.","audio":null,"cues":null,"weight":1},
    {"id":"rap-rain-1","tag":"rain","text":"Rain on the window, that is a mood.","audio":null,"cues":null,"weight":1},
    {"id":"rap-rain-2","tag":"rain","text":"Perfect weather for a slow jam.","audio":null,"cues":null,"weight":1},
    {"id":"rap-fog-1","tag":"fog","text":"Fog on the bay, that is the album cover.","audio":null,"cues":null,"weight":1},
    {"id":"rap-fog-2","tag":"fog","text":"City looks like a dream tonight.","audio":null,"cues":null,"weight":1},
    {"id":"rap-night-1","tag":"night","text":"Night is when the bars get written.","audio":null,"cues":null,"weight":1},
    {"id":"rap-night-2","tag":"night","text":"Moon is out, so am I.","audio":null,"cues":null,"weight":1},
    {"id":"rap-compliment-car-1","tag":"compliment_car","text":"That ride bumps, I can tell.","audio":null,"cues":null,"weight":1},
    {"id":"rap-compliment-car-2","tag":"compliment_car","text":"Clean lines. Respect.","audio":null,"cues":null,"weight":1},
    {"id":"rap-player-wins-race-1","tag":"player_wins_race","text":"That was a verse in motion.","audio":null,"cues":null,"weight":1},
    {"id":"rap-player-wins-race-2","tag":"player_wins_race","text":"You took the whole track!","audio":null,"cues":null,"weight":1},
    {"id":"rap-player-loses-race-1","tag":"player_loses_race","text":"Lose a round, win the next.","audio":null,"cues":null,"weight":1},
    {"id":"rap-player-loses-race-2","tag":"player_loses_race","text":"Shake it off, keep the beat.","audio":null,"cues":null,"weight":1},
    {"id":"rap-sideshow-1","tag":"sideshow","text":"That is a show and a half.","audio":null,"cues":null,"weight":1},
    {"id":"rap-sideshow-2","tag":"sideshow","text":"Smoke and rubber, I love it.","audio":null,"cues":null,"weight":1},
    {"id":"rap-goodbye-1","tag":"goodbye","text":"Peace.","audio":null,"cues":null,"weight":1},
    {"id":"rap-goodbye-2","tag":"goodbye","text":"Catch you on the next track.","audio":null,"cues":null,"weight":1}
  ]
}
