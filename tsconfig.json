{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "apps/web/src",
    "apps/web/test",
    "apps/web/*.ts",
    "packages/*/src",
    "packages/*/test",
    "packages/modes/*/src",
    "packages/modes/*/test",
    "packages/*/scripts",
    "packages/modes/*/scripts",
    "packages/modes/*/src",
    "packages/modes/*/test",
    "tests",
    "tools",
    "config",
    "*.ts"
  ],
  "exclude": ["apps/web/src/sw.ts", "**/node_modules", "**/dist"]
}
