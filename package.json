{
  "name": "tha-bay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "VITE_DV_QA=1 pnpm --filter @dv/ui run tokens && VITE_DV_QA=1 pnpm --filter @dv/web exec vite",
    "build": "pnpm --filter @dv/ui run tokens && pnpm --filter @dv/web exec vite build && tsx tools/ci/check-dist.ts icons",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.sw.json --noEmit && tsc -p services/edge/tsconfig.json --noEmit",
    "lint": "eslint .",
    "check:unit": "tsx tools/ci/run.ts vitest run",
    "check:e2e": "tsx tools/ci/run.ts playwright test",
    "check:e2e:xr": "tsx tools/ci/run.ts playwright test --project=xr-quest3",
    "check:perf": "echo pending: lands in M01c",
    "check:assets": "echo pending: lands in M00b",
    "check:workers": "tsx tools/ci/check-workers.ts",
    "check:headers": "tsx tools/ci/check-dist.ts headers",
    "check:coi": "tsx tools/ci/check-dist.ts coi",
    "check:bundle": "tsx tools/ci/check-dist.ts bundle",
    "icons": "pnpm --filter @dv/web exec pwa-assets-generator",
    "deploy:preview": "tsx tools/ci/deploy.ts preview",
    "deploy:prod": "tsx tools/ci/deploy.ts prod",
    "deploy:bootstrap": "tsx tools/ci/deploy.ts bootstrap"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "tsx": "^4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
