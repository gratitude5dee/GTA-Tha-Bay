{
  "name": "tha-bay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx tools/ci/dev.ts",
    "dev:web": "VITE_DV_QA=1 pnpm --filter @dv/ui run tokens && VITE_DV_QA=1 pnpm --filter @dv/web exec vite",
    "build": "pnpm --filter @dv/ui run tokens && pnpm --filter @dv/web run media:local && pnpm --filter @dv/web exec vite build && tsx tools/ci/third-party-licenses.ts && tsx tools/ci/check-dist.ts icons",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.sw.json --noEmit && tsc -p services/edge/tsconfig.json --noEmit && tsc -p services/pipeline/tsconfig.json --noEmit && tsc -p services/pipeline/tsconfig.node.json --noEmit && tsc -p packages/engine/tsconfig.sim.json --noEmit && tsc -p packages/world/tsconfig.sim.json --noEmit",
    "lint": "eslint .",
    "check:unit": "tsx tools/ci/run.ts vitest run",
    "check:e2e": "tsx tools/ci/run.ts playwright test",
    "check:e2e:xr": "tsx tools/ci/run.ts playwright test --project=xr-quest3",
    "check:perf": "tsx tools/ci/perf-check.ts",
    "perf:verify": "tsx tools/ci/perf-verify.ts",
    "perf:checklist": "tsx tools/ci/perf-checklist.ts",
    "check:assets": "tsx tools/ci/check-assets.ts",
    "check:workers": "tsx tools/ci/check-workers.ts",
    "check:pipeline": "tsx services/pipeline/scripts/check-pipeline.ts",
    "check:c2pa": "tsx tools/ci/check-c2pa.ts",
    "check:secrets": "tsx tools/ci/check-secrets.ts",
    "check:prod-routes": "tsx tools/ci/check-prod-routes.ts",
    "check:do-migrations": "tsx tools/ci/check-do-migrations.ts",
    "check:smoke": "tsx tools/ci/check-smoke.ts",
    "dev:edge": "pnpm --filter @dv/edge exec wrangler dev --port 8788",
    "check:headers": "tsx tools/ci/check-dist.ts headers",
    "check:coi": "tsx tools/ci/check-dist.ts coi",
    "check:bundle": "tsx tools/ci/check-dist.ts bundle",
    "icons": "pnpm --filter @dv/web exec pwa-assets-generator",
    "deploy:preview": "tsx tools/ci/deploy.ts preview",
    "deploy:prod": "tsx tools/ci/deploy.ts prod",
    "deploy:bootstrap": "tsx tools/ci/deploy.ts bootstrap",
    "provenance:check": "tsx tools/ci/provenance-check.ts",
    "provenance:new": "tsx tools/assets/provenance-new.ts",
    "ip:signatures": "tsx tools/ci/ip-scan.ts --signatures",
    "ip:extensions": "tsx tools/ci/ip-scan.ts --extensions",
    "ip:strings": "tsx tools/ci/ip-scan.ts --strings",
    "ip:all": "tsx tools/ci/ip-scan.ts --all",
    "license:scan": "tsx tools/ci/license-scan.ts",
    "reuse:subset": "tsx tools/ci/third-party-subset.ts",
    "reuse:clones": "tsx tools/ci/reuse-clones.ts",
    "names:lint": "tsx tools/ci/names-lint.ts",
    "names:brand": "tsx tools/ci/names-lint.ts --brand",
    "likeness:gate": "tsx tools/ci/likeness-gate.ts",
    "genai:liveness": "tsx tools/assets/genai-liveness.ts",
    "genai:spike": "tsx tools/assets/genai-spike.ts",
    "genai:price": "tsx tools/assets/genai-price.ts",
    "legal:snapshot": "tsx tools/ci/terms-snapshot.ts",
    "check:provenance": "pnpm provenance:check",
    "check:ip": "pnpm ip:all",
    "check:license": "pnpm license:scan",
    "check:names": "pnpm names:lint",
    "check:likeness": "pnpm likeness:gate",
    "assets:catalog": "tsx tools/assets/src/cli.ts catalog",
    "assets:lock": "tsx tools/assets/src/cli.ts lock",
    "assets:verify": "tsx tools/assets/src/cli.ts verify",
    "assets:publish": "tsx tools/assets/src/cli.ts publish",
    "assets:seed": "tsx tools/assets/src/cli.ts seed",
    "map:fixture": "tsx tools/map/src/cli.ts fixture",
    "map:fetch": "tsx tools/map/src/cli.ts fetch",
    "map:build": "tsx tools/map/src/cli.ts build",
    "map:pack": "tsx tools/map/src/cli.ts pack",
    "map:verify": "tsx tools/map/src/cli.ts verify",
    "map:landmarks": "tsx tools/map/src/cli.ts landmarks",
    "map:pois": "tsx tools/map/src/cli.ts pois",
    "map:resolve": "tsx tools/map/src/cli.ts resolve",
    "check:agents": "tsx tools/ci/check-agents.ts",
    "check:telemetry": "tsx tools/ci/check-telemetry.ts",
    "check:rollout": "tsx tools/ci/check-rollout.ts",
    "check:skills": "node -e \"console.log('pending: lands in M13a6')\"",
    "npc:schemas": "tsx tools/soul/src/cli.ts schemas",
    "npc:lint": "tsx tools/soul/src/cli.ts lint",
    "npc:compile": "tsx tools/soul/src/cli.ts compile",
    "npc:build": "tsx tools/soul/src/cli.ts build",
    "npc:consent-index": "tsx tools/soul/src/cli.ts consent-index",
    "npc:summarize": "tsx tools/soul/src/cli.ts summarize",
    "npc:normalize": "tsx tools/soul/src/cli.ts normalize",
    "check:i18n": "tsx tools/ci/check-i18n.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "inkjs": "^2.4.0",
    "meshoptimizer": "1.3.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  }
}
