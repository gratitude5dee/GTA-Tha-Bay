{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tha-bay.invalid/schemas/districts.schema.json",
  "title": "content/world/districts.json (M02a2): 10 districts, outer, stage and the 41 neighbourhoods",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "districts"],
  "properties": {
    "schema": { "const": "world-districts/1" },
    "note": { "type": "string" },
    "districts": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "tier", "profile", "nhoods"],
        "properties": {
          "id": { "type": "string", "pattern": "^(d([1-9]|10)|outer|stage)$" },
          "name": { "type": "string", "minLength": 2 },
          "tier": { "enum": ["A", "B", "C", "stage"] },
          "profile": { "type": "string", "pattern": "^[a-z-]{2,24}$" },
          "nhoods": { "type": "array", "items": { "type": "string", "minLength": 2 } }
        }
      }
    },
    "nhoodProfile": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-z-]{2,24}$" } }
  }
}
