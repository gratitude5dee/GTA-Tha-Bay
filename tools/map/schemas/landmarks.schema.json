{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tha-bay.invalid/schemas/landmarks.schema.json",
  "title": "content/world/landmarks.json (M02a2): the 37 landmark seeds of 02-world-bake.md section 7",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "landmarks"],
  "properties": {
    "schema": { "const": "world-landmarks/1" },
    "note": { "type": "string" },
    "landmarks": {
      "type": "array",
      "minItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lat", "lng", "x", "z", "chunk", "district", "nhood", "cls", "osm", "role", "skyline", "replaceRadiusM"],
        "properties": {
          "id": { "type": "string", "pattern": "^lm\\.[a-z0-9-]{2,60}$" },
          "lat": { "type": "number", "minimum": 37, "maximum": 38.5 },
          "lng": { "type": "number", "minimum": -123, "maximum": -121.5 },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "chunk": { "type": "string", "pattern": "^9/\\d{1,3}/\\d{1,3}$" },
          "district": { "type": "string", "pattern": "^(d([1-9]|10)|outer|stage)$" },
          "nhood": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
          "cls": { "enum": ["hero", "major", "minor"] },
          "osm": { "type": "string", "pattern": "^([wrn][0-9]+|R|S)$" },
          "role": { "type": "string", "minLength": 3 },
          "skyline": { "type": "boolean" },
          "replaceRadiusM": { "type": "number", "minimum": 10, "maximum": 150 },
          "recipe": {
            "type": "object",
            "description": "M02d1: the parameters of tools/map/src/landmarks/<slug>.ts; every recipe takes yawDeg and anchor, the rest is its own (numbers and arrays of numbers).",
            "required": ["yawDeg", "anchor"],
            "properties": { "yawDeg": { "type": "number" }, "anchor": { "enum": ["ground", "sea"] } },
            "additionalProperties": { "anyOf": [{ "type": "number" }, { "type": "array", "items": { "type": "number" } }] }
          }
        }
      }
    }
  }
}
