{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tha-bay.invalid/world-synth.1.json",
  "title": "config/world/synth.json (M02a1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generator", "seed", "land", "landPads", "piers", "terrain", "parks", "landuse", "buildings", "trees", "neighbourhoods"],
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minX", "minZ", "maxX", "maxZ"],
      "properties": { "minX": { "type": "number" }, "minZ": { "type": "number" }, "maxX": { "type": "number" }, "maxZ": { "type": "number" } }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9.-]{2,64}$" }
  },
  "properties": {
    "schema": { "const": "world-synth/1" },
    "generator": { "type": "string" },
    "seed": { "type": "integer" },
    "land": { "$ref": "#/$defs/box" },
    "landPads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "x", "z"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["island", "strip"] },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "size": { "type": "number", "minimum": 160 },
          "width": { "type": "number", "minimum": 160 },
          "length": { "type": "number", "minimum": 160 }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "island" } } }, "then": { "required": ["size"] } },
          { "if": { "properties": { "kind": { "const": "strip" } } }, "then": { "required": ["width", "length"] } }
        ],
        "additionalProperties": false
      }
    },
    "piers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" }, "kind": { "enum": ["line", "polygon"] },
          "x0": { "type": "number" }, "z0": { "type": "number" }, "x1": { "type": "number" }, "z1": { "type": "number" }, "width": { "type": "number", "minimum": 1 },
          "minX": { "type": "number" }, "minZ": { "type": "number" }, "maxX": { "type": "number" }, "maxZ": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "terrain": { "type": "object" },
    "roads": { "type": "object" },
    "parks": { "type": "array", "items": { "type": "object", "required": ["id", "name", "minX", "minZ", "maxX", "maxZ"] } },
    "landuse": { "type": "array", "items": { "type": "object", "required": ["cls", "minX", "minZ", "maxX", "maxZ"] } },
    "buildings": { "type": "object" },
    "trees": { "type": "object", "required": ["perChunk"] },
    "neighbourhoods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cols", "rows", "names"],
      "properties": {
        "cols": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "names": { "type": "array", "minItems": 41, "maxItems": 41, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
