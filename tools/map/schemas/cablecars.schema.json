{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tha-bay.invalid/schemas/cablecars.schema.json",
  "title": "content/world/cablecars.json (M02a2): cable-car lines as street-name chains (U-W6)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lines"],
  "properties": {
    "schema": { "const": "world-cablecars/1" },
    "note": { "type": "string" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "legs"],
        "properties": {
          "id": { "type": "string", "pattern": "^cc\\.[a-z0-9-]{2,32}$" },
          "legs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["street", "from", "to"],
              "properties": { "street": { "type": "string", "minLength": 2 }, "from": { "type": "string", "minLength": 2 }, "to": { "type": "string", "minLength": 2 } }
            }
          }
        }
      }
    }
  }
}
